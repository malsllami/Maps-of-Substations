/**
 * ===================================================
 * PhoneLogin.gs — تسجيل دخول بديل بالرقم فقط (بدون بصمة)
 * ===================================================
 * ملف مستقل تمامًا — لا يمس أي منطق بصمة موجود في WebAuthn.gs إطلاقًا.
 * يعيد استخدام findUser() الموجودة أصلًا في Code.gs بدل تكرار منطق
 * البحث عن العضو والتحقق من حالته.
 *
 * قيد أمني متعمَّد: الدخول بهذه الطريقة يمنح دائمًا صلاحية "عضو عادي"
 * فقط، حتى لو كان الرقم المُدخل هو رقم جوال المدير نفسه — صلاحية
 * "مدير" الكاملة تبقى حصرًا عبر الدخول بالبصمة (verifyAssertion)،
 * لمنع انتحال هوية المدير لمجرد معرفة رقم جواله (رقم الجوال ليس سرًا).
 *
 * لاستعادة الوصول عند فقدان جهاز مسجَّل: يُحذف صف العضو من شيت
 * "بصمات الأجهزة" يدويًا، فيعود لحالة "بلا جهاز مسجَّل" ويسجّل بصمة
 * جديدة من الشاشة الحالية — تُستعاد صلاحية المدير تلقائيًا عندها.
 */
function loginByPhone(data) {
  const phone = formatPhone(data.phone);
  if (!phone) return { error: 'رقم الجوال غير صحيح' };

  const user = findUser(phone);
  if (!user) return { error: 'رقم الجوال غير مسجَّل' };
  if (user.status !== 'نشط') return { error: 'العضوية موقوفة، تواصل مع المدير' };

  logVisit(phone, 'دخول برقم الجوال', 'نجاح');

  return { success: true, role: 'member', name: user.name };
}
